	range 1 1000000
	default 1000

config SOLAR_REMOTE_OUTPUT_LANES
	int
	default 5

config SOLAR_REMOTE_OUTPUT_LANE_DEPTH
	int "Queued frames per output lane"
	range 1 64
	default 4

config SOLAR_REMOTE_ISR_PUBLICATION
	bool "Enable constrained ISR publication"
	default n

config SOLAR_REMOTE_RUNTIME_INTROSPECTION
	bool "Enable bounded Remote runtime introspection"
	default n

config SOLAR_REMOTE_MANIFEST_RETRIEVAL
	bool "Allow bounded runtime manifest retrieval"
	default y

