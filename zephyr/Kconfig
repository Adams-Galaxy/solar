menu "Hardware"

config SOLAR_HARDWARE
	bool "Enable typed Zephyr hardware wrappers"
	default n

if SOLAR_HARDWARE

config SOLAR_HARDWARE_GENERATE_DEVICETREE
	bool "Generate ergonomic devicetree aliases"
	default y

config SOLAR_HARDWARE_GPIO
	bool "Enable GPIO wrappers"
	depends on GPIO
	default y

config SOLAR_HARDWARE_GPIO_INTERRUPTS
	bool "Enable GPIO interrupt ownership wrappers"
	depends on SOLAR_HARDWARE_GPIO
	default y

config SOLAR_HARDWARE_SPI
	bool "Enable SPI wrappers"
	depends on SPI
	default y

config SOLAR_HARDWARE_SPI_ASYNC
	bool "Enable asynchronous SPI operations"
	depends on SOLAR_HARDWARE_SPI && SPI_ASYNC
	default y

config SOLAR_HARDWARE_I2C
	bool "Enable I2C wrappers"
	depends on I2C
	default y

config SOLAR_HARDWARE_I2C_ASYNC
	bool "Enable callback-driven I2C operations"
	depends on SOLAR_HARDWARE_I2C && I2C_CALLBACK
	default y

config SOLAR_HARDWARE_UART
	bool "Enable UART wrappers"
	depends on SERIAL
	default y

config SOLAR_HARDWARE_UART_INTERRUPT
	bool "Enable interrupt-driven UART ownership wrappers"
	depends on SOLAR_HARDWARE_UART && UART_INTERRUPT_DRIVEN
	default y

config SOLAR_HARDWARE_UART_ASYNC
	bool "Enable asynchronous UART ownership wrappers"
	depends on SOLAR_HARDWARE_UART && UART_ASYNC_API
	default y

config SOLAR_HARDWARE_ADC
	bool "Enable ADC wrappers"
	depends on ADC
	default y

config SOLAR_HARDWARE_ADC_ASYNC
	bool "Enable asynchronous ADC reads"
	depends on SOLAR_HARDWARE_ADC && ADC_ASYNC
	default y

config SOLAR_HARDWARE_PWM
	bool "Enable PWM wrappers"
	depends on PWM
	default y

config SOLAR_HARDWARE_PWM_CAPTURE
	bool "Enable PWM capture wrappers"
	depends on SOLAR_HARDWARE_PWM && PWM_CAPTURE
	default y

config SOLAR_HARDWARE_COUNTER
	bool "Enable Counter wrappers"
	depends on COUNTER
	default y

config SOLAR_HARDWARE_WATCHDOG
	bool "Enable hardware Watchdog wrappers"
	depends on WATCHDOG
	default y

config SOLAR_HARDWARE_RTIO
	bool "Enable native RTIO adapters"
	depends on RTIO && (SPI_RTIO || I2C_RTIO || ADC_STREAM)
	default y

endif # SOLAR_HARDWARE

endmenu

menu "Structured logging"

config SOLAR_LOG
	bool "Enable Solar structured logging"
	default n
	help
	  Provide bounded, explicitly owned logging. Applications select sinks;
	  Solar does not replace Zephyr's logging frontend.

if SOLAR_LOG

config SOLAR_LOG_MAX_RECORD_BYTES
	int "Maximum encoded log payload bytes"
	range 64 4096
	default 384

config SOLAR_LOG_MAX_STRING_BYTES
	int "Maximum copied string argument size"
	range 1 1024
	default 96

config SOLAR_LOG_MAX_HEXDUMP_BYTES
	int "Maximum copied hexdump size"
	range 1 4096
	default 128

config SOLAR_LOG_RENDER_BUFFER_BYTES
	int "Bounded rendering buffer size"
	range 64 4096
	default 384

config SOLAR_LOG_ZEPHYR_BRIDGE
	bool "Forward native Zephyr log traffic into Solar sinks"
	depends on LOG
	select LOG_OUTPUT
	default n
	help
	  Registers a Zephyr log backend that relays every native Zephyr log
	  message (including from code with no Application binding, such as
	  the Remote byte engine) into this Application's Solar logger, under
	  one reserved Source. Zephyr's own logging remains fully usable
	  everywhere it always was; this only adds a second destination.

endif # SOLAR_LOG

endmenu

menu "Remote protocol"

config SOLAR_REMOTE
	bool "Solar typed Remote protocol"
	default n
	select COBS
	select CRC
	select ZCBOR
	select ZCBOR_CANONICAL

if SOLAR_REMOTE

