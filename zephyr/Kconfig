	int "Remote response cache bytes per link"
	range 64 8192
	default 512

config SOLAR_REMOTE_MAX_REQUESTS
	int "Maximum concurrently admitted Remote requests"
	range 1 128
	default 8

config SOLAR_REMOTE_MAX_INBOUND_WINDOW
	int "Maximum inbound stream window per link"
	range 1 64
	default 8

config SOLAR_REMOTE_REASSEMBLY_SLOTS
	int "Fragment reassembly slots per link"
	range 1 16
	default 2

config SOLAR_REMOTE_REASSEMBLY_TIMEOUT_MS
