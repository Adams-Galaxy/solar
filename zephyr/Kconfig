	range 64 8192
	default 512

config SOLAR_REMOTE_MAX_REQUESTS
	int "Maximum concurrently admitted Remote requests"
	range 1 128
	default 8

config SOLAR_REMOTE_MAX_INBOUND_WINDOW
	int "Maximum slots in one inbound stream window per link"
	range 1 64
	default 8
	help
	  Compile-time ceiling for a typed ReliableWindow. Storage remains absent
	  for Data declarations without an InStream capability.

config SOLAR_REMOTE_REASSEMBLY_SLOTS
