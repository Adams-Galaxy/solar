#include <zephyr/dt-bindings/adc/adc.h>

/ {
	aliases {
		solar-adc = &solar_adc_endpoint;
		solar-uart = &uart0;
		solar-counter = &counter0;
	};

	solar_adc_endpoint: solar-adc-endpoint {
		compatible = "voltage-divider";
		io-channels = <&adc0 0>;
		output-ohms = <1>;
		full-ohms = <1>;
	};
};

&adc0 {
	ref-internal-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
